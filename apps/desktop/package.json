{
  "name": "@meetless/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Meetless desktop client: Electron main (sync + local cache) and React renderer",
  "type": "module",
  "dependencies": {
    "@meetless/api": "workspace:*",
    "@meetless/client": "workspace:*",
    "@meetless/core": "workspace:*",
    "@meetless/i18n": "workspace:*",
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@meetless/sample": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "1.65.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "main": "dist/main/main.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "node scripts/build-main.mjs && vite build",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:bridge": "node --import tsx src/bridge-host/main.ts",
    "dev:electron": "node scripts/build-main.mjs && MEETLESS_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "start": "node scripts/build-main.mjs && vite build && electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json",
    "test:electron": "bash ../../infra/dev/electron-e2e.sh",
    "package:mac": "node scripts/build-main.mjs && vite build && node scripts/stage-app.mjs && electron-builder --mac --arm64 --config electron-builder.config.cjs --publish never",
    "package:linux": "node scripts/build-main.mjs && vite build && node scripts/stage-app.mjs && electron-builder --linux --config electron-builder.config.cjs --publish never",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "test:mac-gui": "node e2e-electron/mac-packaged.mjs"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
