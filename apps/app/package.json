{
  "name": "@meetless/app",
  "version": "0.2.1",
  "private": true,
  "description": "Meetless on iOS and the web (Expo, React Native, react-native-web)",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --port 8090",
    "web": "expo start --web --port 8090",
    "export:web": "node scripts/web-fonts.mjs && expo export --platform web --output-dir dist --source-maps external && node scripts/notices.mjs dist",
    "serve:web": "node scripts/serve-web.mjs",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.19",
    "@meetless/api": "workspace:*",
    "@meetless/client": "workspace:*",
    "@meetless/core": "workspace:*",
    "@meetless/i18n": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.34",
    "expo-asset": "~57.0.22",
    "expo-build-properties": "~57.0.24",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.25",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.14",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.26",
    "expo-router": "~57.0.32",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "markdown-it": "^14.3.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.17",
    "typescript": "^7.0.2"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
